# Durable settings belong in ~/.config/mirmir/config.toml. These process-local
# overrides are useful for development and automation.
# MIRMIR_CONFIG_HOME=/path/to/config/mirmir
# MIRMIR_STATE_HOME=/path/to/state/mirmir
# MIRMIR_MODEL=qwen--qwen2-5
# MIRMIR_MAX_TOKENS=256
# MIRMIR_TEMPERATURE=0.7
# MIRMIR_TOP_P=0.9
# MIRMIR_TOP_K=40
# MIRMIR_REPETITION_PENALTY=1.0
# MIRMIR_SEED=42
# MIRMIR_HTTP_BIND=127.0.0.1:8080
# MIRMIR_HTTP_API_KEY=change-me
# HF_TOKEN=hf_example
RUST_LOG=mirmir=info,libmir=info
